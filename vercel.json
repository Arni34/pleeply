{
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/community.js": {
      "maxDuration": 10
    },
    "api/forum.js": {
      "maxDuration": 120
    },
    "api/waitlist.js": {
      "maxDuration": 10
    },
    "api/track.js": {
      "maxDuration": 10
    },
    "api/stats.js": {
      "maxDuration": 15
    },
    "api/bot.js": {
      "maxDuration": 300
    },
    "api/ai/v1/chat/completions.js": {
      "maxDuration": 300,
      "includeFiles": "api/_lib/free-catalog.json"
    },
    "api/ai/v1/models.js": {
      "maxDuration": 15,
      "includeFiles": "api/_lib/free-catalog.json"
    },
    "api/account.js": {
      "maxDuration": 20
    },
    "api/ai/v1/connectors.js": {
      "maxDuration": 30
    },
    "api/ai/v1/browse.js": {
      "maxDuration": 300,
      "includeFiles": "node_modules/@sparticuz/chromium/**"
    },
    "api/studio.js": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/chat",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; media-src 'none'; connect-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/chat.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; media-src 'none'; connect-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/studio",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; media-src 'none'; connect-src 'self'; object-src 'none'; frame-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/studio.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; media-src 'none'; connect-src 'self'; object-src 'none'; frame-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/studio/frame",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "sandbox allow-scripts allow-popups allow-popups-to-escape-sandbox; default-src 'none'; script-src 'self' https://cdn.jsdelivr.net; style-src 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src https: data:; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/studio-frame.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "sandbox allow-scripts allow-popups allow-popups-to-escape-sandbox; default-src 'none'; script-src 'self' https://cdn.jsdelivr.net; style-src 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src https: data:; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/assets/studio/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/bot",
      "schedule": "0 6 * * 1"
    }
  ],
  "rewrites": [
    {
      "source": "/pro",
      "destination": "/pro.html"
    },
    {
      "source": "/chat",
      "destination": "/chat.html"
    },
    {
      "source": "/studio",
      "destination": "/studio.html"
    },
    {
      "source": "/studio/frame",
      "destination": "/studio-frame.html"
    },
    {
      "source": "/s/:slug",
      "destination": "/api/studio?op=page&slug=:slug"
    },
    {
      "source": "/api/studio/publish",
      "destination": "/api/studio?op=publish"
    },
    {
      "source": "/api/studio/unpublish",
      "destination": "/api/studio?op=unpublish"
    },
    {
      "source": "/api/paddle/webhook",
      "destination": "/api/account?op=webhook"
    },
    {
      "source": "/api/account/config",
      "destination": "/api/account?op=config"
    },
    {
      "source": "/api/account/portal",
      "destination": "/api/account?op=portal"
    },
    {
      "source": "/api/account/checkout",
      "destination": "/api/account?op=checkout"
    },
    {
      "source": "/api/account/signout",
      "destination": "/api/account?op=signout"
    },
    {
      "source": "/api/account/me",
      "destination": "/api/account?op=me"
    },
    {
      "source": "/api/auth/token",
      "destination": "/api/account?op=token"
    },
    {
      "source": "/api/auth/google/callback",
      "destination": "/api/account?op=callback"
    },
    {
      "source": "/api/auth/desktop",
      "destination": "/api/account?op=start"
    },
    {
      "source": "/api/auth/web",
      "destination": "/api/account?op=webstart"
    },
    {
      "source": "/stats",
      "destination": "/api/stats"
    },
    {
      "source": "/community",
      "destination": "/api/community?view=top"
    },
    {
      "source": "/community/",
      "destination": "/api/community?view=top"
    },
    {
      "source": "/community/top",
      "destination": "/api/community?view=top"
    },
    {
      "source": "/community/latest",
      "destination": "/api/community?view=latest"
    },
    {
      "source": "/community/categories",
      "destination": "/api/community?view=categories"
    },
    {
      "source": "/community/c/:slug",
      "destination": "/api/community?view=category&slug=:slug"
    },
    {
      "source": "/community/t/:id/:slug",
      "destination": "/api/community?view=topic&id=:id"
    },
    {
      "source": "/community/t/:id",
      "destination": "/api/community?view=topic&id=:id"
    },
    {
      "source": "/community/new",
      "destination": "/api/community?view=new"
    },
    {
      "source": "/community/login",
      "destination": "/api/community?view=login"
    },
    {
      "source": "/community/signup",
      "destination": "/api/community?view=signup"
    },
    {
      "source": "/community/sitemap.xml",
      "destination": "/api/community?view=sitemap"
    }
  ]
}
